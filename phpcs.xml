<?xml version="1.0"?>
<ruleset name="Nia Nutrition">
    <description>WPCS ruleset for the Nia Theme and Nia Core plugin. Excludes WordPress core, third-party plugins, and vendor code.</description>

    <file>./wp-content/themes/nia-theme</file>
    <!-- ./wp-content/plugins/nia-core added once the plugin is scaffolded (ARCHITECTURE.md §4) -->


    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/assets/*</exclude-pattern>
    <exclude-pattern>*/src/css/*</exclude-pattern>

    <arg value="sp"/>
    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>

    <rule ref="WordPress"/>
    <rule ref="WordPress-Extra"/>
    <rule ref="WordPress-Docs"/>

    <config name="minimum_supported_wp_version" value="6.5"/>

    <rule ref="PHPCompatibilityWP"/>
    <config name="testVersion" value="8.1-"/>
</ruleset>
