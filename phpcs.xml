<?xml version="1.0"?>
<ruleset name="Nia Nutrition">
    <description>WPCS ruleset for the Nia Theme and Nia Core plugin. Excludes WordPress core, third-party plugins, and vendor code.</description>

    <file>./wp-content/themes/nia-theme</file>
    <file>./wp-content/plugins/nia-core</file>


    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/assets/*</exclude-pattern>
    <exclude-pattern>*/src/css/*</exclude-pattern>

    <arg value="sp"/>
    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>

    <rule ref="WordPress"/>
    <rule ref="WordPress-Extra"/>
    <rule ref="WordPress-Docs"/>

    <!-- index.asset.php is WordPress core's own required naming convention
         for block.json's automatic script-dependency discovery (looked up
         as "{handle}.asset.php" next to index.js) — not a WPCS violation
         to "fix" by renaming. -->
    <rule ref="WordPress.Files.FileName.NotHyphenatedLowercase">
        <exclude-pattern>*/blocks/*/index.asset.php</exclude-pattern>
    </rule>

    <config name="minimum_supported_wp_version" value="6.5"/>

    <rule ref="PHPCompatibilityWP"/>
    <config name="testVersion" value="8.1-"/>
</ruleset>
